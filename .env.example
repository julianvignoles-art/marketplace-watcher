# Copy to .env for local dev, or set these as environment variables on your host.
# There is no login for this app — see the README for why, and the tradeoff
# that comes with it. Only these two variables are actually required.

# SQLite file location. For local dev, "file:./dev.db" is fine as-is (Prisma
# resolves it relative to the prisma/ folder). On a real host, point this at
# an absolute path on a persistent volume/disk instead (e.g. Render/Fly/
# Railway "disk" mounted at /data -> "file:/data/app.db") so data survives
# restarts and redeploys.
DATABASE_URL="file:./dev.db"

# Used to encrypt your stored Facebook cookies at rest. Generate one with:
# openssl rand -hex 32
APP_SECRET="change-me-to-a-long-random-string"

# Optional. If set, POST /api/scan requires this value in an "x-api-key"
# header — only needed if you also want an outside scheduler (a Claude
# scheduled task, cron-job.org, etc.) to be able to trigger a look. Leave
# unset if you're fine relying only on the in-app Settings > Schedule.
SCAN_API_KEY=""
