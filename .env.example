# Copy to .env for local dev, or set these as environment variables on your host.

# SQLite file location. On most hosts, point this at a persistent volume/disk
# (e.g. Render/Fly/Railway "disk" mounted at /data) so data survives restarts.
DATABASE_URL="file:./data/app.db"

# Password to log into the web UI (there is no separate per-user account system).
APP_PASSWORD="change-me"

# Used to encrypt your stored Facebook cookies at rest and to sign login
# session cookies. Generate one with: openssl rand -hex 32
APP_SECRET="change-me-to-a-long-random-string"

# Key required in the "x-api-key" header to trigger POST /api/scan from
# outside (e.g. a Claude scheduled task, or cron-job.org). Generate the same way.
SCAN_API_KEY="change-me-to-another-long-random-string"

# How often the app scans on its own, in minutes. Set to 0 to disable the
# internal timer and rely only on the external trigger above.
SCAN_INTERVAL_MINUTES=60
